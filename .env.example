# MongoDB Atlas connection string. Without it notes live in memory (dev only).
MONGO_URI=
# Public URL, used for canonical links, sitemap and share previews
SITE_URL=http://localhost:3000
# REQUIRED in production for accounts and private notes. Generate: openssl rand -hex 32
SESSION_SECRET=
# Enables the /admin page and moderation API (Bearer token). ADMIN_KEY also works.
ADMIN_TOKEN=
# 1 behind Render/Vercel style proxies so rate limits see real IPs
TRUST_PROXY=1
# Notes per hour per IP and per user (default 10)
NOTE_POSTS_PER_HOUR=10
PORT=3000
